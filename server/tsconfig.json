{  
  "compilerOptions": {   
    "outDir": "./dist",
    "rootDir": "./",
    "module": "nodenext",
    "target": "ES2020",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
    
  },
  "include": [
    "**/*", "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
  
}
